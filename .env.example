# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"


# RESEND_API_KEY: Required for sending emails via Resend.
RESEND_API_KEY=


# JWT_SECRET: Secret key for signing JWT tokens.
JWT_SECRET="MY_JWT_SECRET"

# ADMIN_PASSWORD: Password for the built-in superadmin account (peachstackadmin@gmail.com).
# Default: !Peach$Stack$2026
ADMIN_PASSWORD=


# ADMIN_PASSWORD_VERSION: Increment this (e.g. 1 → 2) whenever you change ADMIN_PASSWORD
# so the next cold start re-hashes and updates the stored admin credentials.
# Default: 1
ADMIN_PASSWORD_VERSION=1

# VITE_GA_MEASUREMENT_ID: Google Analytics 4 measurement ID.
# Create a GA4 property at https://analytics.google.com and paste your G-XXXXXXXXXX ID here.
# Leave blank (or omit entirely) to disable all analytics tracking.
VITE_GA_MEASUREMENT_ID=
